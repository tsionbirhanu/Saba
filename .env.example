# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Seed-only demo/admin setup
ADMIN_EMAIL=admin@saba.local
ADMIN_PASSWORD=replace-with-a-strong-demo-password
ADMIN_NAME=Saba Admin

# Cloudinary uploads
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Payments
PAYMENT_PROVIDER=manual
CHAPA_SECRET_KEY=CHAPA-SECK-your-secret-key
CHAPA_WEBHOOK_SECRET=replace-with-chapa-webhook-secret
CHAPA_CALLBACK_URL=http://localhost:3000/api/payments/chapa/callback
CHAPA_RETURN_URL=http://localhost:3000/checkout/success

# Email
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=Saba Marketplace <onboarding@resend.dev>

# AI
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Legacy/optional provider keys, only set if routes are changed to use them
ANTHROPIC_API_KEY=not-used-by-default

